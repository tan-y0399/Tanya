# 数据库
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/yunwei

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# LLM API
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# 多模态/外部资料专家（真实 Key 只写入 backend/.env，此处仅占位）
ENABLE_MULTIMODAL_AGENT=true
ENABLE_WEB_RESEARCH=true
WEB_SEARCH_PROVIDER=baidu
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_SECRET_KEY=
BAIDU_SEARCH_API_URL=https://qianfan.baidubce.com/v2/ai_search/web_search
BAIDU_SEARCH_API_KEY=your_baidu_qianfan_api_key
BAIDU_SEARCH_SECRET_KEY=
MODELSCOPE_API_KEY=your_modelscope_api_key
MODELSCOPE_API_BASE=https://api-inference.modelscope.cn/v1
IMAGE_GENERATION_MODEL=Tongyi-MAI/Z-Image-Turbo
FLOWCHART_GENERATION_MODEL=Tongyi-MAI/Z-Image-Turbo
FLOWCHART_GENERATION_PROVIDER=zimage
TTS_MODEL=Qwen3-TTS-12Hz-1.7B-VoiceDesign
TTS_API_URL=
TTS_VOICE=Cherry
TTS_VOICE_PROMPT=磁性的女性播音员声音，语速适中，音量适中，表达清晰稳重，适合专业运维讲解。
DASHSCOPE_API_KEY=
VISION_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_LLM_API_KEY=your_dashscope_api_key
VISION_LLM_MODEL=qwen-vl-plus
PADDLEOCR_VL_MODEL_DIR=models/PaddleOCR-VL-1.6
PADDLEOCR_MODEL=PaddlePaddle/PP-OCRv5_server_det
PADDLEOCR_API_URL=
PADDLEOCR_MCP_TOOL=paddleocr_ocr
IMAGE_REVIEW_MIN_SCORE=0.18
IMAGE_REVIEW_SOFT_MIN_SCORE=0.06
IMAGE_REVIEW_KEEP_MIN=1
IMAGE_REVIEW_MAX_CANDIDATES=4
IMAGE_REVIEW_TOTAL_TIMEOUT_SEC=5
IMAGE_REVIEW_OCR_TIMEOUT_SEC=3
GENERATED_ASSET_DIR=data/generated_assets
MCP_SERVER_URL=http://localhost:8100

# SMTP 邮件
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=your_email@qq.com
SMTP_PASSWORD=your_smtp_auth_code
SMTP_FROM_NAME=KylinOps 运维平台

# 开发模式
DEV_MODE=true

# SSH 默认连接
SSH_HOST=192.168.163.15
SSH_PORT=22
SSH_USER=ty
SSH_KEY_PATH=~/.ssh/id_rsa
SSH_TIMEOUT=15

# CORS
CORS_ORIGINS=["*"]
