# 数据库
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/yunwei

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# LLM API
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# SMTP 邮件
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=your_email@qq.com
SMTP_PASSWORD=your_smtp_auth_code
SMTP_FROM_NAME=KylinOps 运维平台

# 开发模式
DEV_MODE=true

# SSH 默认连接
SSH_HOST=192.168.163.15
SSH_PORT=22
SSH_USER=root
SSH_KEY_PATH=~/.ssh/id_rsa
SSH_TIMEOUT=15

# CORS
cors_origins: ["*"]

