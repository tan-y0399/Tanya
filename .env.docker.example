# ============================================================
# KylinOps Docker Compose 环境变量
# 复制为 .env.docker 后修改 LLM_API_KEY
# ============================================================

# ----- 必填：LLM API -----
LLM_API_KEY=your_deepseek_api_key
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ----- 服务端口（宿主机映射） -----
KYLINOPS_PORT=8000

# ----- 安全 -----
JWT_SECRET_KEY=change-me-in-production
DEV_MODE=false

# ----- 数据库（默认 SQLite，数据持久化在 Docker Volume） -----
DATABASE_URL=sqlite+aiosqlite:////app/backend/data/kylinops.db

# ----- Demo SSH 目标机（docker compose --profile demo） -----
SSH_HOST=target-vm
SSH_PORT=22
SSH_USER=ops
SSH_KEY_PATH=/run/secrets/ssh_key
SSH_TIMEOUT=15

# ----- 可选：多模态 / 联网 / 邮件（不配置不影响主流程） -----
ENABLE_MULTIMODAL_AGENT=true
ENABLE_WEB_RESEARCH=false
MCP_SERVER_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=KylinOps 运维平台

WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ----- 可选：PostgreSQL（需 docker compose --profile postgres） -----
# POSTGRES_PASSWORD=postgres
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/yunwei
